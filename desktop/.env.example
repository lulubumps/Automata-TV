# Carpeta con los MP4, vista desde el equipo que ejecuta Docker.
MEDIA_PATH=C:/TV

# La misma biblioteca, con la ruta que usa el PC de OBS.
OBS_MEDIA_ROOT=C:/TV

OBS_URL=ws://host.docker.internal:4455
OBS_PASSWORD=
OBS_SCENE="Automata TV"
OBS_SOURCE=TV_PLAYER
CHANNEL_TZ=America/Santiago
PANEL_BIND=127.0.0.1
PANEL_PORT=8000
PANEL_PASSWORD=
