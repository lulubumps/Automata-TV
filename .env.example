# Copia este archivo como ".env" y ajusta los valores.

# Carpeta de tu PC con los videos (ruta ABSOLUTA).
# Dentro debe tener: Peliculas/  Series/  Comerciales/
#   Windows: C:/TV     Linux: /home/tu-usuario/TV     macOS: /Users/tu-usuario/TV
MEDIA_DIR=/home/tu-usuario/TV

# Contraseña del servidor WebSocket de OBS
OBS_PASSWORD=

# Solo si OBS está en OTRO equipo o contenedor:
# OBS_HOST=192.168.1.50
# OBS_MEDIA_ROOT=D:\Videos     (la misma carpeta, con la ruta que ve OBS)

TZ=America/Santiago
